{
  // Project config, installed by bootstrap/03-project-layout.sh as
  // <project>/opencode.jsonc, above the repo (main/) and the task worktrees, so
  // every checkout under <project>/ loads it and nothing is committed.
  // Docs: https://opencode.ai/v2/docs/config/ , /agents/ , /permissions/
  // Interactive sessions prompt on every `ask`; background runs pass --auto,
  // which approves `ask` but never overrides `deny`.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",

  // Absolute path: relative entries are searched only up to the repo root.
  // Kept out of the upward AGENTS.md search path, so it loads exactly once.
  "instructions": ["TODO_INSTRUCTIONS_PATH"],

  // Worktrees go to <project>/worktrees/<task-id> (relative to main/). OpenCode
  // creates them on a detached HEAD; the project start command
  // (scripts/agent-worktree-setup.sh, registered by bootstrap/08-task-workflow.sh)
  // puts them on branch agent/<task-id>.
  "worktree": { "directory": "../worktrees" },

  // plugins/agent-factory wraps the agents' build and test commands: they run
  // unchanged, with "env" set; each run is logged in the task journal with its
  // full output (setup-guide.md step 8). TODO: the commands that build and run
  // tests, from AGENTS.md (filled by /init), as prefixes, e.g. "cmake" (also
  // covers configuring) and "ctest". If ccache is installed, add it to "env":
  // CMAKE_C_COMPILER_LAUNCHER and CMAKE_CXX_COMPILER_LAUNCHER set to "ccache"
  // (CMake), or "PATH": "/usr/lib/ccache:${PATH}" (Make).
  "plugins": [
    {
      "package": "TODO_PLUGIN_PATH",
      "options": { "commands": ["TODO_BUILD_COMMAND", "TODO_TEST_COMMAND"], "env": {} },
    },
  ],

  // Rules apply in order; the last match wins.
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only commands run without prompting.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "agent-task.sh new *", "effect": "allow" },
    { "action": "edit", "resource": "*.agent/report.md", "effect": "allow" },

    // Agents never push or touch remotes; the developer or orchestrator does.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git remote *", "effect": "deny" },
    // Worktrees and task state go through OpenCode's worktree tools and the scripts.
    { "action": "shell", "resource": "git worktree *", "effect": "deny" },
    { "action": "shell", "resource": "agent-task.sh start *", "effect": "deny" },
    { "action": "shell", "resource": "agent-task.sh done *", "effect": "deny" },

    // Generated files and build output: enforced only here, not repeated in AGENTS.md.
    // TODO: replace with the real paths from AGENTS.md (filled by /init), and add
    // a deny rule for every other generated-file pattern it names.
    { "action": "edit", "resource": "*lex.yy.c", "effect": "deny" },
    // Build output: each CMake preset builds in its binaryDir.
    // TODO: the binaryDir pattern of the presets in CMakePresets.json, e.g.
    // "*/build/*" for "${sourceDir}/build/${presetName}" (AGENTS.md names it).
    { "action": "edit", "resource": "TODO_BUILD_DIR/*", "effect": "deny" },
    // agent-check.sh logs (prebuilds).
    { "action": "edit", "resource": "*.agent/check/*", "effect": "deny" },

    // Agents never edit their own config or instructions. agent-check.conf
    // defines what agent-check.sh runs (background runs pass --auto).
    { "action": "edit", "resource": "*opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "*agent.env", "effect": "deny" },
    { "action": "edit", "resource": "*agent-check.conf", "effect": "deny" },
    { "action": "edit", "resource": "*instructions/AGENTS.md", "effect": "deny" },
  ],

  // Models: TODO, chosen in a separate discussion. Until then the model lines
  // stay commented out and agents use the model picked with /models.
  // Format: openrouter/<vendor>/<model>[#<variant>]  https://opencode.ai/v2/docs/models/
  "agents": {
    "build": {
      // "model": "openrouter/TODO_MAIN_MODEL",
    },
    "plan": {
      // "model": "openrouter/TODO_MAIN_MODEL",
    },
    "explore": {
      // "model": "openrouter/TODO_CHEAP_MODEL",
    },
    "ci-fix": {
      "description": "First repair attempt from a Jenkins failure handoff",
      "mode": "primary",
      // "model": "openrouter/TODO_CHEAP_MODEL",
      "system": "You fix one failing Jenkins build. The handoff gives the task, the diff summary, previous attempts and a failure excerpt. Make the smallest change that fixes the failure, build and run the failing tests as background commands, commit, and stop. Do not refactor or widen the scope. If the failure is not caused by the change (infrastructure, flaky test), say so and stop without editing.",
    },
  },
}
